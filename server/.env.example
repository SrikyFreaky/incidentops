DATABASE_URL="postgresql://user:password@localhost:5432/incidentops"
SHADOW_DATABASE_URL="postgresql://postgres:password@localhost:5432/incidentops_shadow"
SESSION_SECRET="generate-a-long-random-string-for-this"
PORT=4000

# Only needed in production against a pooled connection (e.g. Supabase's
# connection pooler) — see prisma/schema.prisma's `directUrl` comment.
# Leave unset for local Postgres; DATABASE_URL alone is fine there.
# DIRECT_URL="postgresql://user:password@host:5432/dbname"
