generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  // Normal app queries go through Supabase's connection pooler — the
  // direct connection is IPv6-only, which Render (and most PaaS hosts)
  // can't reach at all. `directUrl`, below, is what `prisma migrate`
  // actually uses instead, since schema changes need a real session
  // connection, not a transaction-pooled one.
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  // Local-dev-only: `prisma migrate dev`'s scratch database for diffing
  // schema changes. Not used in production at all (migrate deploy, which
  // Render runs, doesn't need a shadow database).
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum IncidentEventType {
  CREATED
  STATUS_CHANGED
  COMMENT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  memberships      TeamMembership[]
  createdIncidents Incident[]       @relation("IncidentCreatedBy")
  events           IncidentEvent[]  @relation("EventActor")

  @@map("users")
}

model Team {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  memberships TeamMembership[]
  incidents   Incident[]

  @@map("teams")
}

// Join table for the users <-> teams many-to-many relationship. Enforced
// server-side as of Day 6: every incident route checks for a matching row
// here before allowing access to that team's incidents.
model TeamMembership {
  id        String         @id @default(uuid())
  teamId    String
  userId    String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_memberships")
}

model Incident {
  id          String         @id @default(uuid())
  // Monotonically increasing, never exposed in API responses — exists
  // purely so cursor pagination has a stable sort key that can't collide,
  // the same problem the in-memory `seq` counter solved before Postgres.
  seq         BigInt         @unique @default(autoincrement())
  title       String
  description String         @default("")
  severity    Severity
  status      IncidentStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?

  // Required as of Day 6: real auth/team membership exists now, so every
  // incident has a genuine team and creator to attribute it to.
  teamId      String
  createdById String

  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User            @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  events    IncidentEvent[]

  @@map("incidents")
}

model IncidentEvent {
  id         String            @id @default(uuid())
  incidentId String
  type       IncidentEventType
  message    String            @default("")
  actorId    String?
  createdAt  DateTime          @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User?    @relation("EventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("incident_events")
}
